// Studentët.KS — skema e të dhënave.
//
// Provideri është SQLite për zhvillim lokal. Kalimi në PostgreSQL është vetëm
// ndërrim i `provider` dhe i `DATABASE_URL`, prandaj skema shmang çdo veçori
// specifike të njërit motor: pa enum-e (String plus tipe TypeScript), pa fusha
// vargje (String me JSON brenda, shih lib/json.ts), pa tipin Json.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Institucionet
// ---------------------------------------------------------------------------

model University {
  id          String   @id @default(cuid())
  name        String
  abbr        String   @unique
  logo        String?
  emailDomain String?
  city        String
  createdAt   DateTime @default(now())

  faculties Faculty[]
  users     User[]
}

model Faculty {
  id           String @id @default(cuid())
  universityId String
  name         String
  /// Çelës i temës vizuale: economics | medicine | law | science | philology | arts
  color        String
  icon         String

  university  University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departments Department[]
  users       User[]
  posts       Post[]
  events      Event[]

  @@unique([universityId, name])
  @@index([universityId])
}

model Department {
  id        String @id @default(cuid())
  facultyId String
  name      String

  faculty Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  courses Course[]
  users   User[]

  @@unique([facultyId, name])
  @@index([facultyId])
}

model Course {
  id           String @id @default(cuid())
  departmentId String
  name         String
  code         String
  year         Int
  semester     Int
  ects         Int
  professor    String

  department  Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  materials   Material[]
  questions   Question[]
  posts       Post[]
  groups      Group[]
  slots       ScheduleSlot[]
  examDates   ExamDate[]

  @@unique([departmentId, code])
  @@index([departmentId, year])
}

/// Termini javor i ligjëratës. Orari i studentit ndërtohet nga këto, jo me dorë.
model ScheduleSlot {
  id        String @id @default(cuid())
  courseId  String
  /// 1 = e hënë ... 7 = e diel
  dayOfWeek Int
  startTime String
  endTime   String
  room      String
  kind      String @default("lecture")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model ExamDate {
  id       String   @id @default(cuid())
  courseId String
  term     String
  date     DateTime
  room     String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, date])
}

model Enrollment {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  academicYear String
  createdAt    DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, academicYear])
  @@index([courseId])
}

// ---------------------------------------------------------------------------
// Njerëzit
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String?
  username     String  @unique
  name         String
  avatar       String?
  bio          String?
  universityId String?
  facultyId    String?
  departmentId String?
  /// 1..4 për bachelor, 1..2 për master
  year         Int?
  /// bachelor | master | phd
  level        String?
  city         String?
  highSchool   String?
  isVerified   Boolean @default(false)

  xp           Int       @default(0)
  dailyStreak  Int       @default(0)
  lastStreakAt DateTime?
  streakFreeze Int       @default(2)

  /// student | moderator | admin | company
  role      String   @default("student")
  interests String   @default("[]")
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  emailVerified DateTime?
  onboardedAt   DateTime?

  showReadReceipts Boolean @default(true)
  pushEnabled      Boolean @default(false)
  analyticsConsent Boolean @default(false)

  university University?  @relation(fields: [universityId], references: [id])
  faculty    Faculty?     @relation(fields: [facultyId], references: [id])
  department Department?  @relation(fields: [departmentId], references: [id])

  enrollments   Enrollment[]
  posts         Post[]
  comments      Comment[]
  reactions     Reaction[]
  bookmarks     Bookmark[]
  materials     Material[]
  ratings       MaterialRating[]
  questions     Question[]
  answers       Answer[]
  answerVotes   AnswerVote[]
  pollVotes     PollVote[]
  groupMembers  GroupMember[]
  messages      Message[]
  eventsCreated Event[]
  rsvps         Rsvp[]
  badges        UserBadge[]
  accounts      Account[]
  sessions      Session[]

  following      Follow[]       @relation("follower")
  followers      Follow[]       @relation("following")
  notifications  Notification[] @relation("recipient")
  actedOn        Notification[] @relation("actor")
  reportsFiled   Report[]       @relation("reporter")
  reportsHandled Report[]       @relation("moderator")
  invitesSent    Invite[]       @relation("inviter")
  inviteUsed     Invite?        @relation("invitedUser")
  blocksMade     UserBlock[]    @relation("blocker")
  blocksTaken    UserBlock[]    @relation("blocked")
  conversations  ConversationMember[]
  pushSubs       PushSubscription[]

  @@index([facultyId, year])
  @@index([universityId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  isMutual    Boolean  @default(false)
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  /// block | mute
  kind      String   @default("block")
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Invite {
  id            String    @id @default(cuid())
  inviterId     String
  code          String    @unique
  invitedUserId String?   @unique
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  inviter     User  @relation("inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitedUser User? @relation("invitedUser", fields: [invitedUserId], references: [id])

  @@index([inviterId])
}

// ---------------------------------------------------------------------------
// Përmbajtja sociale
// ---------------------------------------------------------------------------

model Post {
  id          String  @id @default(cuid())
  authorId    String
  /// text | question | material | poll | event | seek | campus_voice
  type        String
  text        String
  /// JSON: string[]
  media       String  @default("[]")
  courseId    String?
  facultyId   String?
  groupId     String?
  materialId  String?
  eventId     String?
  isAnonymous Boolean @default(false)
  pseudonym   String?

  score      Float    @default(0)
  likeCount  Int      @default(0)
  commentCount Int    @default(0)
  saveCount  Int      @default(0)
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  course   Course?   @relation(fields: [courseId], references: [id])
  faculty  Faculty?  @relation(fields: [facultyId], references: [id])
  group    Group?    @relation(fields: [groupId], references: [id])
  material Material? @relation(fields: [materialId], references: [id])
  event    Event?    @relation(fields: [eventId], references: [id])

  comments    Comment[]
  reactions   Reaction[]
  pollOptions PollOption[]

  @@index([createdAt])
  @@index([authorId])
  @@index([courseId])
  @@index([type])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  text      String
  parentId  String?
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("thread", fields: [parentId], references: [id])
  children Comment[] @relation("thread")

  @@index([postId])
}

model Reaction {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  /// like | helpful | celebrate
  type      String   @default("like")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  targetId   String
  /// post | material | question | event | job
  targetType String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId, targetType])
  @@index([userId, targetType])
}

model PollOption {
  id     String @id @default(cuid())
  postId String
  text   String
  order  Int    @default(0)

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([postId])
}

model PollVote {
  id        String   @id @default(cuid())
  optionId  String
  userId    String
  postId    String
  createdAt DateTime @default(now())

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([optionId])
}

// ---------------------------------------------------------------------------
// Akademia
// ---------------------------------------------------------------------------

model Material {
  id                 String  @id @default(cuid())
  uploaderId         String
  courseId           String
  title              String
  /// lecture | script | notes | past_exam | solved | slides | book | video
  type               String
  fileUrl            String
  mimeType           String  @default("application/pdf")
  size               Int
  pages              Int?
  professor          String?
  academicYear       String
  description        String?
  rating             Float   @default(0)
  ratingCount        Int     @default(0)
  downloads          Int     @default(0)
  /// pending | verified | rejected | hidden
  verificationStatus String  @default("pending")
  isHidden           Boolean @default(false)

  createdAt DateTime @default(now())

  uploader User             @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  ratings  MaterialRating[]
  posts    Post[]

  @@index([courseId, type])
  @@index([uploaderId])
}

model MaterialRating {
  id         String   @id @default(cuid())
  materialId String
  userId     String
  value      Int
  comment    String?
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([materialId, userId])
}

model Question {
  id               String  @id @default(cuid())
  authorId         String
  courseId         String
  title            String
  text             String
  acceptedAnswerId String?
  views            Int     @default(0)
  isHidden         Boolean @default(false)
  /// Ora kur u dërguan njoftimet te studentët që e kanë kaluar lëndën.
  nudgedAt         DateTime?
  createdAt        DateTime @default(now())

  author  User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([courseId, createdAt])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  authorId   String
  text       String
  votes      Int      @default(0)
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())

  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  voters   AnswerVote[]

  @@index([questionId])
}

model AnswerVote {
  id       String @id @default(cuid())
  answerId String
  userId   String
  value    Int

  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([answerId, userId])
}

// ---------------------------------------------------------------------------
// Grupet dhe bisedat
// ---------------------------------------------------------------------------

model Group {
  id          String  @id @default(cuid())
  name        String
  /// course | generation | custom
  type        String
  courseId    String?
  /// public | request | invite
  privacy     String  @default("public")
  description String?
  avatar      String?
  facultyKey  String?

  createdAt DateTime @default(now())

  course  Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members GroupMember[]
  posts   Post[]

  @@index([type])
  @@index([courseId])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  /// member | moderator | owner
  role     String   @default("member")
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Conversation {
  id        String   @id @default(cuid())
  /// direct | group
  type      String   @default("direct")
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  /// Kërkesa nga jo-shokë presin pranim.
  isAccepted     Boolean  @default(true)
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String
  text           String
  /// JSON: string[]
  media          String   @default("[]")
  /// JSON: string[] me id-të e përdoruesve
  readBy         String   @default("[]")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Jeta reale
// ---------------------------------------------------------------------------

model Event {
  id          String   @id @default(cuid())
  creatorId   String
  title       String
  description String
  date        DateTime
  endDate     DateTime?
  location    String
  facultyId   String?
  /// lecture | exam | fair | party | contest | workshop | study_together
  kind        String   @default("workshop")
  createdAt   DateTime @default(now())

  creator User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  faculty Faculty? @relation(fields: [facultyId], references: [id])
  rsvps   Rsvp[]
  posts   Post[]

  @@index([date])
}

model Rsvp {
  id      String @id @default(cuid())
  eventId String
  userId  String
  /// going | maybe | not_going
  status  String @default("going")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Company {
  id          String  @id @default(cuid())
  name        String  @unique
  logo        String?
  description String
  website     String?
  city        String?
  isVerified  Boolean @default(false)

  jobs JobPost[]
}

model JobPost {
  id          String   @id @default(cuid())
  companyId   String
  title       String
  /// internship | part_time | full_time | scholarship | contest | exchange | hackathon
  type        String
  field       String
  city        String
  isRemote    Boolean  @default(false)
  description String
  deadline    DateTime
  link        String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([type, deadline])
}

// ---------------------------------------------------------------------------
// Gamification, njoftime, moderim
// ---------------------------------------------------------------------------

model Badge {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String
  icon        String

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  /// Kontekst opsional, p.sh. emri i lëndës për "Lider i lëndës".
  context  String?
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId, context])
  @@index([userId])
}

model Notification {
  id       String  @id @default(cuid())
  userId   String
  /// follow | follow_back | mutual | comment | answer | accepted | material | event | streak | badge | question_nudge | reactivation
  type     String
  actorId  String?
  targetId String?
  text     String
  /// Konteksti i lexueshëm, p.sh. "Jeni bashkë në 3 lëndë."
  context  String?
  isRead   Boolean @default(false)

  createdAt DateTime @default(now())

  user  User  @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  targetId    String
  /// post | comment | material | user | message | answer
  targetType  String
  /// harassment | hate | targeting | sexual | threat | spam | personal_data | copyright | other
  reason      String
  note        String?
  /// open | reviewing | actioned | dismissed
  status      String   @default("open")
  moderatorId String?
  resolution  String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  reporter  User  @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator User? @relation("moderator", fields: [moderatorId], references: [id])

  @@index([status, createdAt])
  @@index([targetId, targetType])
}

/// Regjistri publik i agreguar i moderimit ("kjo javë: 14 postime të hequra").
model ModerationLog {
  id         String   @id @default(cuid())
  weekOf     DateTime
  removed    Int      @default(0)
  reviewed   Int      @default(0)
  dismissed  Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([weekOf])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
