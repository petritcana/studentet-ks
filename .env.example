# Baza e të dhënave.
# Lokalisht: SQLite (file:./prisma/dev.db). Në prodhim: PostgreSQL.
# Skema është e bartshme mes të dyjave: pa enum, pa fusha vargje, pa tipin Json.
DATABASE_URL="file:./dev.db"

# Auth.js v5. Gjenero një sekret me: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Adresa publike. Përdoret nga sitemap, robots dhe metadata e Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Asistenti AI. Pa çelës, lib/ai përdor MockAiProvider dhe UI-ja e thotë hapur.
ANTHROPIC_API_KEY=""
AI_PROVIDER="mock"

# Pagesat.
# Stripe dhe PayPal nuk i mbështesin kompanitë e Kosovës, prandaj lib/billing ka
# gjashtë ofrues pas së njëjtës ndërfaqe. Ofruesi pa çelësa nuk shfaqet fare te
# faqja e Pro-s, prandaj këto rreshta mund të mbeten bosh gjatë zhvillimit.

# Paddle: Merchant of Record, rekomandimi kryesor për Kosovën.
PADDLE_VENDOR_ID=""
PADDLE_API_KEY=""
PADDLE_CHECKOUT_URL=""

# Bankat vendore: ProCredit, NLB, Raiffeisen.
LOCALBANK_ENDPOINT=""
LOCALBANK_MERCHANT=""

# Transfertë bankare me kod referencë. Konfirmohet manualisht nga /admin.
BANK_IBAN=""

# Llogaritë demo dhe ndërruesi «Shfaq si falas / Pro». Kurrë "true" në prodhim.
DEMO_MODE="true"

# Modeli i asistentit.
# Cdo sherbim qe flet gjuhen e OpenAI-t punon: OpenRouter, Groq, Together, ose
# Ollama lokal. Pa keto rreshta asistenti bie te ofruesi demonstrues dhe e thote
# hapur nen kutine e shkrimit, prandaj asgje nuk prishet gjate zhvillimit.
#
# Falas dhe pa kufi mesazhesh praktik, zgjidhja e rekomanduar:
#   1. Hap nje llogari te openrouter.ai dhe merr nje celes.
#   2. Vendos rreshtat si me poshte.
# AI_BASE_URL="https://openrouter.ai/api/v1"
# AI_MODEL="meta-llama/llama-3.3-70b-instruct:free"
#
# Ose Groq, me i shpejte:
#   AI_BASE_URL="https://api.groq.com/openai/v1"
#   AI_MODEL="llama-3.3-70b-versatile"
#
# Ose Ollama lokal, pa celes fare:
#   AI_BASE_URL="http://localhost:11434/v1"
#   AI_MODEL="llama3.2"
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
