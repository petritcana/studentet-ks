# Baza e të dhënave. Skema shkruhet për PostgreSQL (me pgvector për kërkim semantik).
DATABASE_URL="file:./dev.db"

# Auth.js v5. Gjenero një sekret me: npx auth secret
AUTH_SECRET="zhvillim-lokal-ndrysho-ne-prodhim-0123456789abcdef"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Asistenti AI. Pa çelës, lib/ai përdor MockAiProvider dhe UI-ja e thotë hapur.
ANTHROPIC_API_KEY=""
AI_PROVIDER="anthropic"

# Pagesat. Në zhvillim, MockProvider e aktivizon Pro-n menjëherë.
BILLING_PROVIDER="mock"
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""

# Llogaritë demo dhe ndërruesi i tyre. Kurrë "true" në prodhim.
DEMO_MODE="true"
